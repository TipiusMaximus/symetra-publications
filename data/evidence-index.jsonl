{"id":"EV-ENERGYREV-GAP-001","entity":"Hamina vs Kemi exploratory comparison","period":"mixed","domain":"resource_intensity","metric":"hamina_over_kemi_floor_electricity_per_revenue","value":5.593,"unit":"times_approx","status":"derived_scope_jump","boundary":"Hamina electricity/revenue estimate divided by Kemi conservative floor","sourceRefs":["S087","S090","S068","S091"],"formula":"1.9218 / 0.3436","note":"Upper-bound-like spread against a conservative Kemi floor; not a harmonized efficiency ranking. Equality would occur at roughly 416 M€ Kemi site revenue for 0.8 TWh/y electricity use."}
{"id":"EV-KEMI-GRID-001","entity":"Metsä Fibre Kemi bioproduct mill","period":"current source / annual design-operation figure","domain":"grid","metric":"derived_net_electricity_export","value":1.2,"unit":"TWh_per_year_approx","status":"derived_from_company_reported","boundary":"Kemi bioproduct mill annual electricity balance","sourceRefs":["S068"],"formula":"2.0 TWh generation - (2.0 TWh / 2.5) consumption","note":"Metsä Fibre reports 2.0 TWh/y generation, 250% electricity self-sufficiency and that surplus electricity is delivered to the national grid. 1.2 TWh/y is derived annual net surplus, not separately reported metered gross export."}
{"id":"EV-KEMI-GRID-002","entity":"Metsä Fibre Kemi bioproduct mill","period":"current source / annual design-operation figure","domain":"grid","metric":"net_grid_dependence","value":-150,"unit":"percent_of_own_electricity_consumption","status":"derived_from_company_reported","boundary":"(net grid import - net grid export) / own electricity consumption","sourceRefs":["S068"],"formula":"(0.8 TWh - 2.0 TWh) / 0.8 TWh × 100","note":"Negative means annual net exporter. This is a normalized annual balance, not gross hourly import/export."}
