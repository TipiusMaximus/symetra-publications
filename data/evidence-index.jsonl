{"id":"EV-KEMI-WATERREV-002","entity":"Metsä Fibre Kemi bioproduct mill","period":"2025","domain":"resource_intensity","metric":"actual_withdrawal_per_whole_business_revenue_floor","value":12622.692,"unit":"m3_per_million_EUR_revenue_at_least_approx","status":"derived_cross_boundary_floor","boundary":"Kemi 2025 actual withdrawal / all Metsä Fibre 2025 revenue","sourceRefs":["S092","S086"],"formula":"32,819,000 m3 / 2,600 M€","note":"Conservative floor: denominator is all Metsä Fibre revenue, not Kemi mill revenue."}
