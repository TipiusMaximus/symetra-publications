{
  "version": "0.1",
  "principle": "Generate ratios only from explicit recipes. Every recipe names numerator, denominator, unit conversions, period policy and boundary policy; no blind Cartesian product of evidence.",
  "boundaryPolicies": {
    "strict": "Same conceptual entity/boundary required.",
    "near_match": "Boundaries are close enough for an exploratory ratio but the mismatch must remain visible.",
    "cross_boundary": "Different boundaries are intentionally combined to expose structure; never render as harmonized score."
  },
  "periodPolicies": {
    "same": "Same period required.",
    "near_period": "Adjacent/mixed periods allowed only with explicit warning.",
    "mixed_explicit": "Different periods are intentional and must be labelled."
  },
  "rabbitHoleHeuristics": {
    "absolute_multiple": 4,
    "group_spread": 4,
    "note": "Thresholds are discovery heuristics, not value judgments. A flag asks a question; it does not rank entities."
  },
